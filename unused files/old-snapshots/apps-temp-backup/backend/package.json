{
  "name": "autoprint-backend",
  "version": "1.0.0",
  "description": "Production-grade fail-safe AutoPrint verification and payment backend service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "tsc && node --test dist/tests/*.test.js"
  },
  "keywords": [
    "autoprint",
    "spooler",
    "verification",
    "upi",
    "cash-collection"
  ],
  "author": "AutoPrint Engineering",
  "license": "Apache-2.0",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.3.0",
    "pdf-lib": "^1.17.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.7",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
