# ===============================================================================
#   AUTOPRINT / QRPRINT — PRODUCTION GITIGNORE
# ===============================================================================

# Dependencies
node_modules/
**/node_modules/
.venv/

# Build and Packaging Output
dist/
**/dist/
dist-installer/
dist-electron/
build/
**/build/
out/
release/
.next/
*.old.exe

# Environment & Secrets (Preserve templates only)
.env
.env.*
.env.local
.env.*.local
!.env.example

# Local SQLite Databases & WAL Journal files
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Datastore Persistent Storage (Keep directory structures only)
datastore/customer/uploads/*
!datastore/customer/uploads/.gitkeep
datastore/customer/documents/*
!datastore/customer/documents/.gitkeep
datastore/backend/database/*
!datastore/backend/database/.gitkeep
datastore/backend/audit/*
!datastore/backend/audit/.gitkeep
datastore/backend/logs/*
!datastore/backend/logs/.gitkeep
datastore/backups/*
!datastore/backups/.gitkeep
datastore/temp/*
!datastore/temp/.gitkeep
uploads/*
!uploads/.gitkeep

# Runtime Ephemeral Data & Logs
runtime/logs/*
!runtime/logs/.gitkeep
runtime/temp/*
!runtime/temp/.gitkeep
runtime/pid/*
!runtime/pid/.gitkeep
runtime/status/*
!runtime/status/.gitkeep
logs/
temp/
tmp/

# Log Files & Debuggers
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# System & OS Files
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# IDE & Editor Settings
.vscode/
.idea/
