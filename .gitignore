# Dependencies
node_modules/
**/node_modules/

# Build Output
dist/
**/dist/
dist-installer/
build/
**/build/
out/
release/
.next/
*.old.exe

# Environment Secrets
.env
.env.local
.env.*.local
!.env.example

# Local Databases & SQLite
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Datastore Persistent Data
datastore/customer/uploads/*
!datastore/customer/uploads/.gitkeep
datastore/customer/documents/*
!datastore/customer/documents/.gitkeep
datastore/backend/database/*
!datastore/backend/database/.gitkeep
datastore/backend/audit/*
!datastore/backend/audit/.gitkeep
datastore/backend/logs/*
!datastore/backend/logs/.gitkeep
datastore/backups/*
!datastore/backups/.gitkeep
datastore/temp/*
!datastore/temp/.gitkeep

# Runtime Ephemeral Data
runtime/logs/*
!runtime/logs/.gitkeep
runtime/temp/*
!runtime/temp/.gitkeep
runtime/pid/*
!runtime/pid/.gitkeep
runtime/status/*
!runtime/status/.gitkeep

# System & Editor
.DS_Store
Thumbs.db
desktop.ini
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.vscode/
.idea/
