    "backups": "datastore/backups",
    "uploads": "datastore/customer/uploads",
    "database": "datastore/backend/database",
    "logs": "datastore/backend/logs"
  },
  "defaults": {
    "currency": "INR",
    "environment": "development",
    "maxDigitalAttempts": 3
  }
}
