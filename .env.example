# AutoPrint / QRPrint Production Environment Configuration Template

# Server & Application Ports (Configurable: 1024 - 65535)
PORT=5000
MERCHANT_PORT=6000
CUSTOMER_PORT=7000

# Environment: development | production | test
NODE_ENV=development

# REST API Route Prefix
API_PREFIX=/api

# Max Digital (UPI) Payment Attempts before mandatory Cash Lockout
MAX_DIGITAL_ATTEMPTS=3

# HMAC Secret Key for Physical Verification Watermark Checksums (Must be >= 32 chars in production)
HMAC_SECRET=AP_VERIFY_HMAC_SECURE_2026_CHANGE_THIS_IN_PRODUCTION

# Allowed CORS Origins (comma-separated or * for dev)
CORS_ORIGIN=http://localhost:5000,http://localhost:6000,http://localhost:7000,http://localhost:3000,http://localhost:3001,http://localhost:8085

# Default Currency (INR for India, USD for US)
CURRENCY=INR

# Maximum Upload File Size in Megabytes
MAX_FILE_SIZE_MB=50

# Application Persistent Data Directory (default: ./datastore or E:\QRPrint\AutoPrint\datastore)
AUTOPRINT_DATA_DIR=./datastore
