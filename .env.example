# AutoPrint / QRPrint Production Environment Configuration Template
PORT=5000
MERCHANT_PORT=8000
CUSTOMER_PORT=7000
NODE_ENV=development
API_PREFIX=/api
MAX_DIGITAL_ATTEMPTS=3
HMAC_SECRET=AP_VERIFY_HMAC_SECURE_2026_CHANGE_THIS_IN_PRODUCTION
CORS_ORIGIN=http://localhost:5000,http://localhost:6000,http://localhost:7000
CURRENCY=INR
MAX_FILE_SIZE_MB=50
AUTOPRINT_DATA_DIR=./datastore
DEFAULT_PRINTER=AutoPrint Virtual Spooler

# Optional central customer site used for V2 store QR codes.
AUTOPRINT_CLOUD_URL=https://autoprint.com
